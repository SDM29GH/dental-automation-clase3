# =====================================================================
# DENTAL CARE RETENTION ENGINE — variables de entorno
# Copiar a .env y completar con credenciales reales.
# =====================================================================

NODE_ENV=development
PORT=3000
TIMEZONE=America/Mexico_City

# ---------------- PostgreSQL ----------------
DATABASE_URL="postgresql://dental_user:dental_pass@localhost:5432/dental_care?schema=public"

# ---------------- Evolution API (WhatsApp) ----------------
# Docs: https://doc.evolution-api.com
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="cambia-esta-clave"
EVOLUTION_INSTANCE="consultorio-laura"
# Lada del país para armar el número completo al enviar (México = 52).
# La base guarda los últimos 10 dígitos; no cambies esto si el consultorio es mexicano.
WHATSAPP_PAIS="52"
# Opcional: si se define, el webhook debe enviar el header x-webhook-secret
EVOLUTION_WEBHOOK_SECRET=""

# ---------------- Google Calendar ----------------
# Crear en Google Cloud Console > APIs > Google Calendar API
GOOGLE_CLIENT_ID="tu-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu-client-secret"
GOOGLE_REFRESH_TOKEN=""
# IDs de calendario separados por coma (el correo de la cuenta o "primary")
CALENDAR_IDS="primary"

# ---------------- LLM (NLU) ----------------
# "openai" apunta a cualquier API compatible con OpenAI, incluido Ollama:
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3.2:3b
#   LLM_API_KEY=ollama
# Si LLM_API_KEY está vacío, el motor usa solo reglas deterministas.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=""

# ---------------- Alertas a la asistente ----------------
ADMIN_WEBHOOK=""
ADMIN_EMAIL=""

# ---------------- Panel de la asistente ----------------
# Si defines PANEL_PASSWORD, el panel pide usuario y contraseña.
# Si la dejas vacía, sólo responde a peticiones desde localhost (desarrollo).
PANEL_USER=asistente
PANEL_PASSWORD=

# ---------------- SMTP (opcional, para alertas por correo) ----------------
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

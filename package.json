{
  "name": "dental-care-retention-engine",
  "version": "1.0.0",
  "description": "Motor de automatización para consultorios dentales: recordatorios inteligentes por WhatsApp, retención de pacientes y seguimiento de tratamientos multisesión.",
  "type": "module",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx scripts/seed.ts",
    "sync:calendar": "tsx scripts/sync-calendar.ts",
    "demo": "tsx scripts/mock-ejemplo.ts",
    "oauth": "tsx scripts/setup-google-oauth.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "axios": "^1.8.4",
    "date-fns": "^4.1.0",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.0",
    "zod": "^3.25.63"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.19.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
